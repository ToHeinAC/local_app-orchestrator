# Copy to .env and adjust. All values are optional — the defaults below apply.

# Port this orchestrator serves on. 8550 avoids Streamlit's default 8501 and the
# ports of the apps it routes to (8520, 8530).
APP_PORT=8550

# Host used to build the fallback URL for an app that has no public URL
# (http://<APP_HOST>:<port>). Only reachable from this machine / the LAN.
APP_HOST=localhost

# App registry. A list of records does not belong in .env — see apps.toml.
APPS_FILE=apps.toml

# Seconds to wait for an app's port to accept a connection before calling it
# offline. Every app is probed on each page load, so keep this short.
PROBE_TIMEOUT=0.3
